// Based on BlackDark/agent-presets (templates/renovate.template.json5).
// The shared rules live in BlackDark/renovate-base. Repo settings: "Allow auto-merge" on, and the `check`
// status check required on main. The ruleset requires branches to be up to date, so rebase on behind-base-branch
// or platform automerge stalls on PRs that fell behind main.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>blackdark/renovate-base//default.json5", // path after // is required for .json5
    "github>blackdark/renovate-base//go.json5",
    ":pinVersions", // exact versions in package.json; libraries: remove, ranges belong there
  ],

  // Platform automerge (GitHub native) merges a PR as soon as `check` passes, also between weekly windows.
  updateNotScheduled: false,
  platformAutomerge: true,
  rebaseWhen: "behind-base-branch",

  separateMultipleMajor: true,

  // Keep go.sum tidy and rewrite import paths on /vN majors.
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],

  packageRules: [
    {
      description: "Intentionally frozen: server-side NTLM implementation of a stable protocol (MS-NLMP). No viable alternative exists. Monitored for CVEs via govulncheck in CI.",
      matchPackageNames: ["github.com/bigkraig/go-ntlm", "github.com/ThomsonReutersEikon/go-ntlm"],
      enabled: false,
    },
    {
      description: "Majors: one PR each, merged by hand",
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
      automerge: false,
    },
  ],
}
